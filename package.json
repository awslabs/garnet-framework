{
  "name": "garnet",
  "version": "1.6.0",
  "bin": {
    "garnet": "bin/garnet.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "audit:deploy": "npm audit --omit=dev && npm audit --prefix lib/layers/nodejs",
    "synth": "cdk synth --quiet",
    "cdk": "cdk",
    "preinstall": "node install.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "aws-cdk": "^2.1138.0",
    "constructs": "^10.8.1",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "aws-cdk-lib": "2.266.0",
    "constructs": "^10.8.1",
    "source-map-support": "^0.5.21"
  }
}
